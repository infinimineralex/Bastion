{
  "name": "bastion",
  "version": "1.0.0",
  "description": "A secure file vault for your sensitive data",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "app:dir": "vite build && electron-builder --dir",
    "app:dist": "vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.alexander.bastion", 
    "files": [
      "electron/**/*",
      "dist/**/*",
      "public/**/*",
      "!node_modules/@types/react{,/**}",
      "!node_modules/@types/react-dom{,/**}"
    ],
    "mac": {
      "category": "public.app-category.security"
    }
  },
  "keywords": [],
  "author": "Alexander Haga",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.1",
    "vite": "^6.3.3",
    "wait-on": "^8.0.3"
  }
}
